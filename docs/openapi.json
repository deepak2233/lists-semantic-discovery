{
  "openapi": "3.1.0",
  "info": {
    "title": "LISTS Discovery API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/config": {
      "get": {
        "summary": "Configuration",
        "operationId": "configuration_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommend": {
      "post": {
        "summary": "Recommend",
        "operationId": "recommend_v1_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecommendRequest": {
        "properties": {
          "page_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Page Url"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 1800,
            "minLength": 40,
            "title": "Summary"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Keywords"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language",
            "default": "en"
          },
          "limit": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          },
          "exclude_same_host": {
            "type": "boolean",
            "title": "Exclude Same Host",
            "default": true
          },
          "ranking": {
            "type": "string",
            "enum": [
              "auto",
              "lexical",
              "semantic"
            ],
            "title": "Ranking",
            "default": "auto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page_url",
          "title",
          "summary"
        ],
        "title": "RecommendRequest"
      },
      "RecommendResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode"
          },
          "ranker": {
            "type": "string",
            "title": "Ranker"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "candidate_count": {
            "type": "integer",
            "title": "Candidate Count"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings Ms"
          },
          "pipeline_version": {
            "type": "string",
            "title": "Pipeline Version",
            "default": "lists-v2"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "mode",
          "ranker",
          "recommendations",
          "warnings",
          "candidate_count",
          "cached",
          "elapsed_ms"
        ],
        "title": "RecommendResponse"
      },
      "Recommendation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "host": {
            "type": "string",
            "title": "Host"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "ranking_score": {
            "type": "number",
            "title": "Ranking Score"
          },
          "lexical_score": {
            "type": "number",
            "title": "Lexical Score",
            "default": 0.0
          },
          "semantic_similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Similarity"
          },
          "provider_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Rank"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "snippet",
          "host",
          "reason",
          "ranking_score"
        ],
        "title": "Recommendation"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

LISTS_ENV=development
LISTS_PROVIDER=demo
LISTS_AUTH_MODE=none
# Live web retrieval: LISTS_PROVIDER=brave
BRAVE_API_KEY=
# Optional: uv sync --extra semantic; use a reviewed model directory, never a remote model ID.
LISTS_MODEL_PATH=
# Cache disabled by default. Enable only after reviewing provider retention rights.
CACHE_TTL_SECONDS=0
PROVIDER_TIMEOUT_SECONDS=3
REQUESTS_PER_MINUTE=30
MAX_INFLIGHT=8
LISTS_ALLOWED_HOSTS=127.0.0.1,localhost
LISTS_ALLOWED_ORIGINS=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
JWT_REQUIRED_SCOPE=recommend:read
